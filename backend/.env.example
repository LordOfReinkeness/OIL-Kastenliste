NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=kastenliste

# Let TypeORM auto-create/update tables on startup — enable for dev, never for production with real data
DB_SYNCHRONIZE=false

# Shared admin password for the /api/auth/login endpoint
ADMIN_PASSWORD=changeme

# Secret used to sign the session cookie — use a long random string in production
SESSION_SECRET=changeme

# Set to "true" in production (behind HTTPS reverse proxy), "false" for local dev over plain HTTP
COOKIE_SECURE=false

# Port the backend listens on (default: 3000, set to 3030 in dev to avoid Obsidian)
PORT=3000
